{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- 一覧のデザインは未着手なので仮。トップの NoteBook と同じ並びにする --}}
<main class="voyage-list">
    <section class="voyage-section voyage-notebook">
        {{> "components/section-heading" script="NoteBook" label="学び"}}
        {{#if @member}}
            <div class="voyage-notebook-list">
                {{#foreach posts}}
                    {{> "components/notebook-card"}}
                {{else}}
                    {{> "components/empty"}}
                {{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            {{!-- 非会員には free タグの付いた記事だけを並べ、1 件も無ければ入会の案内を出す。
                  page を渡すのは、{{pagination}} が作る /page/N/ のリンクと取り出す記事を揃えるため --}}
            {{#get "posts" filter="tag:notebook+tag:free" limit=@config.posts_per_page page=pagination.page}}
                {{#if posts}}
                    <div class="voyage-notebook-list">
                        {{#foreach posts}}
                            {{> "components/notebook-card"}}
                        {{/foreach}}
                    </div>
                    {{pagination}}
                {{else}}
                    {{> "components/paid-only"}}
                {{/if}}
            {{/get}}
        {{/if}}
    </section>
</main>
