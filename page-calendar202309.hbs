{{!< default}}
{{!-- Template for /calendar202401/ page --}}


{{!-- ページタイトルを設定 --}}
<script>
    // ページのタイトルを取得して設定
    document.addEventListener('DOMContentLoaded', function() {
        const titleElement = document.querySelector('#calendar-detail-content');
        if (titleElement) {
            // calendar-detail.jsがタイトルを設定するまで待つ
            const observer = new MutationObserver(function(mutations) {
                const h2 = document.querySelector('#calendar-detail-content h2');
                if (h2) {
                    document.title = h2.textContent + ' | {{@site.title}}';
                    observer.disconnect();
                }
            });
            observer.observe(titleElement, { childList: true, subtree: true });
        }
    });
</script>
{{> "components/search-form"}}

{{#match @custom.header_style "!=" "Highlight"}}
    {{> "components/featured" showFeatured=@custom.show_featured_posts limit=4}}
{{/match}}

{{> "components/cta"}}

<div id="cat_header">
    {{> "components/breadcrumb"}}
</div>

<div class="gh-content-wrapper">
    <main class="gh-main-content">
        {{> "components/content-menu" active="calendar"}}

        {{!-- Card container --}}
        <div class="cardtype cf test">

        </div>

        {{!-- Calendar detail content --}}
        <div id="calendar-detail-content" data-page-slug="calendar202309"></div>

        {{> "calendar-posts-data"}}

        {{!-- Calendar list --}}
        <div id="past_sale" class="cf">
            <p>
                {{#get "pages" limit="all" order="slug desc"}}
                    {{#foreach pages}}
                        <span class="calendar-item" data-slug="{{slug}}">
                            <small><a href="{{url}}">{{title}}</a></small>
                        </span>
                    {{/foreach}}
                {{/get}}
            </p>
        </div>

        {{> "components/content-menu" active="calendar"}}
    </main>

    {{> "sidebar"}}
</div>
