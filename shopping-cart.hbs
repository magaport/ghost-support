{{!< default }}

<main class="gh-main">
  <fms-cart inline="true" hide-button="true" checkout-url="/checkout/" continue-shopping-url="/product/list/"></fms-cart>
  <script>
    document.addEventListener("fms:event", function(e) {
      var type = e.detail && e.detail.eventType;
      if (type === "modal_close") history.back();
    });
  </script>
</main>
