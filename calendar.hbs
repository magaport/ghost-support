{{!< default}}
{{!-- Template for /calendar page - showing upcoming release calendar --}}

{{!-- ページタイトルを設定 --}}
<script>
    document.title = '発売カレンダー | {{@site.title}}';
</script>

{{> "components/search-form"}}

{{#match @custom.header_style "!=" "Highlight"}}
    {{> "components/featured" showFeatured=@custom.show_featured_posts limit=4}}
{{/match}}

{{> "components/cta"}}

<div id="cat_header">
    {{> "components/breadcrumb"}}
</div>

<div class="gh-content-wrapper">
    <main class="gh-main-content">
        {{> "components/content-menu" active="calendar"}}

        {{!-- Today button --}}
        <a href="#" class="btn-simple">Today</a>

        {{!-- Card container --}}
        <div class="cardtype cf test">

        </div>

        {{!-- Calendar content --}}
        <div id="past_sale" class="cf">
            <p>
                {{!-- Content will be loaded dynamically by calendar.js --}}
            </p>
        </div>

        {{> "components/content-menu" active="calendar"}}
    </main>

    {{> "sidebar"}}
</div>
