{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

<main class="raiden-home">

    <section class="raiden-hero">
        <img class="raiden-hero-bolt" src="{{asset "images/raiden_thunder1.png"}}" alt="" width="52" height="253">

        <div class="raiden-hero-brand">
            {{!-- ロゴ画像に "TEAM RAIDEN OFFICAL FAN COMMUNITY" の行まで入っている --}}
            <img class="raiden-hero-logo" src="{{asset "images/raiden_logo.png"}}" alt="ROOM RAIDEN — TEAM RAIDEN OFFICAL FAN COMMUNITY" width="284" height="90">
        </div>

        <div class="raiden-hero-visual">
            <img class="raiden-hero-image" src="{{asset "images/raiden_top.png"}}" alt="TEAM RAIDEN" width="390" height="350">
            <a class="raiden-button raiden-hero-cta" href="{{@site.url}}/about/">ROOM RAIDEN とは</a>
        </div>
    </section>

    {{!-- 文面は Figma のダミーのまま。本番の文面が来たら差し替える --}}
    <section class="raiden-section raiden-news">
        <h2 class="raiden-heading"><span class="raiden-heading-text">News</span></h2>
        <div class="raiden-news-body">
            <p>この文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーですこの文章はダミーです</p>
        </div>
    </section>

    {{!-- デザインにページャが無いのでトップには出さない。posts を絞ると 2 ページ目
          以降が辿れなくなるため、1 ページ分は丸ごと出す --}}
    <section class="raiden-section raiden-articles">
        <h2 class="raiden-heading"><span class="raiden-heading-text">Article</span></h2>

        <div class="raiden-card-grid">
            {{#foreach posts}}
                {{> "components/card"}}
            {{/foreach}}
        </div>
    </section>

</main>
