{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- ページタイトルを設定 --}}
<script>
    // 元のタイトルから "ページ N" を抽出（ページネーション対応）
    const originalTitle = document.title;
    const pageMatch = originalTitle.match(/ページ (\d+)|Page (\d+)/);
    const pageNum = pageMatch ? (pageMatch[1] || pageMatch[2]) : null;
    // 1ページ目の場合はページ番号を含めない
    const pagePart = (pageMatch && pageNum !== '1') ? ` | ${pageMatch[0]}` : '';

    // URLに応じてタイトルを設定
    if (window.location.pathname === '/') {
        document.title = '{{@site.title}} | 雑誌の付録をフラゲ開封レビューでご紹介';
    } else if (window.location.pathname.startsWith('/new')) {
        document.title = '新着情報' + pagePart + ' | {{@site.title}}';
    }

    // 検索結果ページのタイトル設定
    const urlParams = new URLSearchParams(window.location.search);
    const searchQuery = urlParams.get('s');
    if (searchQuery) {
        document.title = '"' + searchQuery + '" の検索結果 | {{@site.title}}';
    }
</script>

{{> "components/search-form"}}

{{#match @custom.header_style "!=" "Highlight"}}
    {{> "components/featured" showFeatured=@custom.show_featured_posts limit=4}}
{{/match}}

{{> "components/cta"}}

<div class="gh-content-wrapper">
    <main class="gh-main-content">
        {{> "components/content-menu" active="home"}}

        <div class="search_results__header"></div>

        <div class="post-grid" id="search-results-container">
        </div>

        <div class="load-more-wrap text-center">
            <p>
                <a href="/new/page/2/" class="btn raised red-bc strong center">もっと見る</a>
            </p>
        </div>

        <div class="search-pagination-wrap" style="display: none;">
            <nav
                class="pagination dfont"
                role="navigation"
                data-current-page="1"
                data-total-pages="1"
                data-first-url="/new/"
                data-second-url="/new/page/2/"
            >
                <ul class="page-numbers"></ul>
            </nav>
        </div>

        {{> "components/content-menu" active="home"}}
    </main>

    {{> "sidebar"}}
</div>