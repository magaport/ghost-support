{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

<main class="raiden-home">

    <section class="raiden-hero">
        <div class="raiden-hero-brand">
            {{!-- ロゴ画像に "TEAM RAIDEN OFFICAL FAN COMMUNITY" の行まで入っている --}}
            <img class="raiden-hero-logo" src="{{asset "images/raiden_logo.png"}}" alt="ROOM RAIDEN — TEAM RAIDEN OFFICAL FAN COMMUNITY" width="349" height="111">
        </div>

        <div class="raiden-hero-visual">
            <img class="raiden-hero-image" src="{{asset "images/raiden_top.png"}}" alt="TEAM RAIDEN" width="480" height="431">
            <a class="raiden-button raiden-hero-cta" href="{{@site.url}}/about/">ROOM RAIDEN とは</a>
        </div>
    </section>

    {{!-- News は `news` スラッグの固定ページから引く。先方が本文を差し替えられるようにするため --}}
    {{#get "pages" filter="slug:news" limit="1" as |newsPage|}}
        {{#foreach newsPage}}
            <section class="raiden-section raiden-news">
                <h2 class="raiden-heading"><span class="raiden-heading-text">News</span></h2>
                <div class="raiden-news-body">{{content}}</div>
            </section>
        {{/foreach}}
    {{/get}}

    {{!-- posts を絞ると index の 2 ページ目が 13 件目から始まり、5〜12 件目が
          どこからも辿れなくなるため、1 ページ分を丸ごと出してページャを付ける --}}
    <section class="raiden-section raiden-articles">
        <h2 class="raiden-heading"><span class="raiden-heading-text">Article</span></h2>

        <div class="raiden-card-grid">
            {{#foreach posts}}
                {{> "components/card"}}
            {{/foreach}}
        </div>

        {{#if pagination}}
            <nav class="raiden-pagination">
                {{#if pagination.prev}}<a href="{{page_url pagination.prev}}">前へ</a>{{/if}}
                <span>{{pagination.page}} / {{pagination.pages}}</span>
                {{#if pagination.next}}<a href="{{page_url pagination.next}}">次へ</a>{{/if}}
            </nav>
        {{/if}}
    </section>

</main>

{{> "components/member-gate"}}
