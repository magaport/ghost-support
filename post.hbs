{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}
<main class="raiden-post">

    <article class="{{post_class}}">
        <header class="raiden-article-header">
            <h1 class="raiden-article-title">{{title}}</h1>
            <time class="raiden-article-date" datetime="{{date format="YYYY-MM-DD"}}">date {{date format="YYYY.MM.DD"}}</time>

            {{#if tags}}
                <div class="raiden-article-tags">
                    {{#foreach tags}}
                        <a href="{{url}}">{{name}}</a>
                    {{/foreach}}
                </div>
            {{/if}}
        </header>

        {{#if feature_image}}
            <img class="raiden-article-image" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
        {{/if}}

        <div class="gh-content raiden-page-body">
            {{content}}
        </div>
    </article>

    {{#if comments}}
        <div class="raiden-section">
            {{comments title="Comments" count=false}}
        </div>
    {{/if}}

</main>
{{/post}}
