{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- 記事詳細のデザインは未着手なので仮。News / Log / NoteBook で分けず 1 枚で持つ --}}
{{#post}}
<main class="voyage-post">

    <article class="voyage-section {{post_class}}">
        <header class="voyage-article-header">
            <h1 class="voyage-article-title">{{title}}</h1>
            <time class="voyage-date" datetime="{{date format="YYYY-MM-DD"}}">date {{date format="YYYY.MM.DD"}}</time>
        </header>

        {{#if feature_image}}
            <img class="voyage-article-image"
                srcset="{{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w"
                sizes="336px"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{/if}}

        {{!-- 会員限定の記事で権限が無いときは、Ghost 標準の入会案内が {{content}} の末尾に出る --}}
        <div class="gh-content voyage-article-body">
            {{content}}
        </div>

        {{!-- 本文を読めないメンバーにいいねだけ押させない --}}
        {{#if @member}}
            {{#if access}}
                <div class="voyage-article-like">
                    {{> "post-like" post_id=id}}
                </div>
            {{/if}}
        {{/if}}
    </article>

    {{#if comments}}
        <div class="voyage-section voyage-comments">
            {{comments title="Comments" count=false}}
        </div>
    {{/if}}

</main>
{{/post}}
