{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}
<main class="raiden-page">

    {{#match @page.show_title_and_feature_image}}
        <div class="raiden-section raiden-page-title">
            <h1 class="raiden-heading"><span class="raiden-heading-text">{{title}}</span></h1>
        </div>

        {{#if feature_image}}
            <img class="raiden-page-visual" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
        {{/if}}
    {{/match}}

    <div class="gh-content raiden-page-body">
        {{content}}
    </div>

</main>
{{/post}}
