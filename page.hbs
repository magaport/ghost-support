{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- 利用規約・プライバシーポリシー・特商法に基づく表示・Voyage+ とは を管理画面の固定ページで書く。デザインは未着手なので仮 --}}
{{#post}}
<main class="voyage-page">

    <article class="voyage-section">
        {{#match @page.show_title_and_feature_image}}
            {{!-- ナビに並ぶページだけ英字を重ねる。英字と和文は管理画面のタイトルから決められないので slug で引く --}}
            <header class="voyage-article-header">
                {{#match slug "about"}}
                    {{> "components/page-title" script="About" label="Voyage+ とは"}}
                {{else match slug "profile"}}
                    {{> "components/page-title" script="Profile" label="プロフィール"}}
                {{else match slug "faq"}}
                    {{> "components/page-title" script="FAQ" label="よくある質問"}}
                {{else}}
                    <h1 class="voyage-article-title">{{title}}</h1>
                {{/match}}
            </header>

            {{#if feature_image}}
                <img class="voyage-article-image" src="{{img_url feature_image size="l"}}" alt="{{title}}">
            {{/if}}
        {{/match}}

        <div class="gh-content voyage-article-body">
            {{content}}
        </div>
    </article>

</main>
{{/post}}
