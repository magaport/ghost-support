{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

<main class="voyage-list">
    <section class="voyage-section voyage-log">
        {{> "components/section-heading" script="Log" label="日常"}}
        {{!-- 非会員には一覧を見せず、見出しの下に入会の案内を出す --}}
