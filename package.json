{
    "name": "voyage",
    "description": "Voyage+ — 公式ファンコミュニティのテーマ",
    "demo": "https://voyage.unleashcms.dev",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "deploy:local": "gulp zip && node .github/scripts/preview-deploy.mjs",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "test:workflow": "node --test '.github/scripts/*.test.mjs'",
        "pretest": "gulp build"
    },
    "author": {
        "name": "Ghost Foundation",
        "email": "hello@ghost.org",
        "url": "https://ghost.org/"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/magaport/ghost-support.git"
    },
    "bugs": "https://github.com/magaport/Unleash/issues",
    "devDependencies": {
        "@tryghost/admin-api": "^1.14.11",
        "@tryghost/release-utils": "0.8.1",
        "autoprefixer": "10.4.7",
        "beeper": "2.1.0",
        "cssnano": "5.1.12",
        "gscan": "4.48.0",
        "gulp": "4.0.2",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "9.0.1",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "5.1.0",
        "inquirer": "8.2.4",
        "postcss": "8.2.13",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.0"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            },
            "hero": {
                "width": 2880
            }
        },
        "card_assets": true
    },
    "renovate": {
        "extends": [
            "@tryghost:theme"
        ]
    }
}
