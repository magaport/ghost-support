{
    "name": "raiden",
    "description": "ROOM RAIDEN — TEAM RAIDEN official fan community theme",
    "demo": "https://roomraiden.com",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "gulp",
        "zip": "gulp zip",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "test:workflow": "node --test '.github/scripts/*.test.mjs'",
        "pretest": "gulp build"
    },
    "author": {
        "name": "magaport",
        "email": "support@magaport.co.jp",
        "url": "https://github.com/magaport"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/magaport/ghost-support.git"
    },
    "bugs": "https://github.com/magaport/Unleash/issues",
    "devDependencies": {
        "@tryghost/admin-api": "^1.14.11",
        "@tryghost/release-utils": "0.8.1",
        "autoprefixer": "10.4.7",
        "beeper": "2.1.0",
        "cssnano": "5.1.12",
        "gscan": "4.48.0",
        "gulp": "4.0.2",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "9.0.1",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "5.1.0",
        "inquirer": "8.2.4",
        "postcss": "8.2.13",
        "postcss-easy-import": "4.0.0",
        "pump": "3.0.0"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 320
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "announcement_text": {
                "type": "text",
                "description": "ヘッダー下のお知らせバーに出す文言。空のときはバーを出さない"
            },
            "announcement_url": {
                "type": "text",
                "description": "お知らせバーのリンク先。空のときはリンクにしない"
            },
            "youtube_url": {
                "type": "text",
                "description": "フッターの YouTube アイコンのリンク先"
            },
            "instagram_url": {
                "type": "text",
                "description": "フッターの Instagram アイコンのリンク先"
            },
            "x_url": {
                "type": "text",
                "description": "フッターの X アイコンのリンク先"
            }
        }
    },
    "renovate": {
        "extends": [
            "@tryghost:theme"
        ]
    }
}
