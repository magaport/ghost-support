{
	"name": "source",
	"description": "A default theme for the Ghost publishing platform",
	"demo": "https://source.ghost.io",
	"version": "1.2.2",
	"packageManager": "yarn@1.22.22",
	"engines": {
		"ghost": ">=5.0.0"
	},
	"license": "MIT",
	"scripts": {
		"dev": "gulp",
		"zip": "gulp zip",
		"test": "gscan .",
		"test:ci": "gscan --fatal --verbose .",
		"pretest": "gulp build",
		"preship": "yarn test",
		"ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; else echo \"Uncomitted changes found.\" && exit 1; fi",
		"postship": "git fetch && gulp release"
	},
	"author": {
		"name": "Ghost Foundation",
		"email": "hello@ghost.org",
		"url": "https://ghost.org/"
	},
	"gpm": {
		"type": "theme",
		"categories": [
			"Minimal",
			"Magazine"
		]
	},
	"keywords": [
		"ghost",
		"theme",
		"ghost-theme"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/TryGhost/Source.git"
	},
	"bugs": "https://github.com/TryGhost/Source/issues",
	"contributors": "https://github.com/TryGhost/Source/graphs/contributors",
	"devDependencies": {
		"@tryghost/release-utils": "^0.8.1",
		"autoprefixer": "10.4.7",
		"beeper": "2.1.0",
		"cssnano": "5.1.12",
		"gscan": "4.39.4",
		"gulp": "4.0.2",
		"gulp-concat": "2.6.1",
		"gulp-livereload": "4.0.2",
		"gulp-postcss": "9.0.1",
		"gulp-uglify": "3.0.2",
		"gulp-zip": "5.1.0",
		"inquirer": "8.2.4",
		"postcss": "8.2.13",
		"postcss-easy-import": "4.0.0",
		"pump": "3.0.0"
	},
	"browserslist": [
		"defaults"
	],
	"config": {
		"posts_per_page": 16,
		"image_sizes": {
			"xs": {
				"width": 160
			},
			"s": {
				"width": 320
			},
			"m": {
				"width": 600
			},
			"l": {
				"width": 960
			},
			"xl": {
				"width": 1200
			},
			"xxl": {
				"width": 2000
			}
		},
		"card_assets": true,
		"custom": {
			"navigation_layout": {
				"type": "select",
				"options": [
					"Logo in the middle",
					"Logo on the left",
					"Stacked"
				],
				"default": "Logo in the middle"
			},
			"site_background_color": {
				"type": "color",
				"default": "#ffffff"
			},
			"title_font": {
				"type": "select",
				"options": [
					"Modern sans-serif",
					"Elegant serif",
					"Consistent mono"
				],
				"default": "Modern sans-serif"
			},
			"body_font": {
				"type": "select",
				"options": [
					"Modern sans-serif",
					"Elegant serif"
				],
				"default": "Modern sans-serif"
			},
			"header_style": {
				"type": "select",
				"options": [
					"Landing",
					"Highlight",
					"Magazine",
					"Search",
					"Off"
				],
				"description": "Landing is recommended for all sites, Highlight & Magazine for those with more content",
				"default": "Landing",
				"group": "homepage"
			},
			"show_featured_posts": {
				"type": "boolean",
				"default": false,
				"group": "homepage",
				"visibility": "header_style:[Highlight, Magazine]"
			},
			"post_feed_style": {
				"type": "select",
				"options": [
					"List",
					"Grid"
				],
				"default": "List",
				"group": "homepage"
			},
			"show_images_in_feed": {
				"type": "boolean",
				"default": true,
				"group": "homepage",
				"visibility": "post_feed_style:List"
			},
			"show_author": {
				"type": "boolean",
				"default": true,
				"group": "homepage"
			},
			"show_publish_date": {
				"type": "boolean",
				"default": true,
				"group": "homepage"
			},
			"show_publication_info_sidebar": {
				"type": "boolean",
				"default": false,
				"group": "homepage"
			},
			"show_post_metadata": {
				"type": "boolean",
				"default": true,
				"group": "post"
			},
			"enable_drop_caps_on_posts": {
				"type": "boolean",
				"default": false,
				"group": "post"
			},
			"show_related_articles": {
				"type": "boolean",
				"default": true,
				"group": "post"
			},
			"cove_id": {
				"type": "text",
				"default": "",
				"description": "CoveコメントウィジェットのID（Cove管理画面で確認できるdata-cove-id）。空の場合はCoveスクリプトが読み込まれません。"
			},
			"community_api_domain": {
				"type": "text",
				"default": "",
				"description": "コミュニティ機能のAPIドメイン（例: https://api.example.com）。空の場合は同一ドメインの相対パスを使います。"
			},
			"community_web_domain": {
				"type": "text",
				"default": "",
				"description": "コミュニティ機能のWebドメイン（例: https://community.example.com）。ルーム詳細・一覧へのリンク先に使います。空の場合は同一ドメインの相対パスを使います。"
			},
			"fms_api_key": {
				"type": "text",
				"default": "",
				"description": "FMS APIキー（initializeのkパラメータ）"
			},
			"fms_service_path": {
				"type": "text",
				"default": "",
				"description": "FMSサービスパス（APIベースURLの第2セグメント）"
			},
			"fms_loader_url": {
				"type": "text",
				"default": "",
				"description": "FMSローダー(mp-fms-js)のベースURL。例: https://melty.unleashcms.dev/fms-js 。空はローカル開発(http://localhost:18081)。"
			},
			"fms_cart_url": {
				"type": "text",
				"default": "",
				"description": "FMSカート(mp-fms-cart)のベースURL。例: https://melty.unleashcms.dev/fms-cart 。空はローカル開発。"
			},
			"fms_api_base_url": {
				"type": "text",
				"default": "",
				"description": "FMS API(base-api)のベースURL。servicePathが第2セグメントとして付与される。例: https://melty.unleashcms.dev 。空はローカル開発。"
			},
			"fms_tkm_domain": {
				"type": "text",
				"default": "",
				"description": "FMS TKM(認証)ドメイン。例: https://melty.unleashcms.dev/tkm 。空はローカル開発。"
			},
			"fms_host": {
				"type": "text",
				"default": "",
				"description": "FMSホスト(medusa)のURL。initializeのhパラメータ。例: https://melty.unleashcms.dev 。空はローカル開発。"
			}
		}
	},
	"renovate": {
		"extends": [
			"@tryghost:theme"
		]
	}
}
