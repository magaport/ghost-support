{{!-- {{pagination}} ヘルパーが差し込む partial --}}
{{#if pages}}
    {{#match pages ">" 1}}
        <nav class="voyage-pagination" aria-label="ページ送り">
            {{#if prev}}<a class="voyage-pagination-prev" href="{{page_url prev}}">前へ</a>{{/if}}
            <span class="voyage-pagination-current">{{page}} / {{pages}}</span>
            {{#if next}}<a class="voyage-pagination-next" href="{{page_url next}}">次へ</a>{{/if}}
        </nav>
    {{/match}}
{{/if}}
