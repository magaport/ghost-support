<div class="gh-post-like-wrapper">
    <button
        class="gh-post-like-button"
        type="button"
        aria-label="いいね"
        data-post-id="{{post_id}}"
        data-member-email="{{@member.email}}"
        data-member-id=""
        data-content-api-key="{{content_api_key}}"
        data-liked="false"
    >
        <svg class="gh-post-like-icon" width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path class="heart-fill" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            <path class="heart-outline" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke-width="2"/>
        </svg>
    </button>
    <span class="gh-post-like-count"></span>
</div>