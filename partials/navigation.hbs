{{!-- {{navigation}} ヘルパーが差し込む partial。ヘルパーを通さないと項目に
      slug と current が付かず、{{url}} が nav として扱われない --}}
{{!-- ハンバーガーは Primary、フッターの利用規約などは Secondary のナビから引く --}}
<ul class="{{#if isSecondary}}voyage-footer-menu{{else}}voyage-menu-list{{/if}}">
    {{#foreach navigation}}
        <li><a href="{{url absolute="true"}}">{{label}}</a></li>
    {{/foreach}}
</ul>
