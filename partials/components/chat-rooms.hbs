{{!--
    チャットルーム一覧。
    home.hbs から {{> "components/chat-rooms"}} で呼び出すことを想定。

    - data-community-api-domain に @custom.community_api_domain を埋め込み、APIフェッチに使う
    - data-community-web-domain に @custom.community_web_domain を埋め込み、リンク遷移先に使う
    - 各ドメインが空の場合は同一ドメインの相対パスを使う
    - 初期状態は hidden。chat-rooms.js が available を取得できたら表示する
--}}
<section
    class="gh-home-contents gh-chat-rooms"
    data-chat-rooms
    data-community-api-domain="{{@custom.community_api_domain}}"
    data-community-web-domain="{{@custom.community_web_domain}}"
    hidden
>
    <div class="gh-home-contents-inner">
        <div class="gh-home-contents-head">
            <h2 class="gh-home-contents-head-title">チャットルーム</h2>
        </div>
        <div class="gh-chat-rooms-feed" data-chat-rooms-feed></div>
    </div>
</section>
<style>
    .gh-chat-rooms-feed {
        display: flex;
        gap: 16px;
        overflow-x: auto;
    }
    .gh-chat-room-card {
        flex: 0 0 auto;
        width: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }
    .gh-chat-room-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        background-color: rgba(0, 0, 0, 0.08);
    }
    .gh-chat-room-icon--placeholder {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        color: rgba(0, 0, 0, 0.45);
    }
    .gh-chat-room-name {
        margin: 8px 0 0;
        font-size: 14px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .gh-chat-room-more {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: center;
        border-radius: 50%;
        border: 2px solid currentColor;
        font-size: 22px;
        text-decoration: none;
        color: inherit;
        opacity: 0.6;
        transition: opacity 0.15s;
    }
    .gh-chat-room-more:hover {
        opacity: 1;
    }
</style>
