{{!--
    チャットルーム一覧。
    home.hbs から {{> "components/chat-rooms"}} で呼び出すことを想定。

    - data-community-api-domain に @custom.community_api_domain を埋め込み、APIフェッチに使う
    - data-community-web-domain に @custom.community_web_domain を埋め込み、リンク遷移先に使う
    - 各ドメインが空の場合は同一ドメインの相対パスを使う
    - 初期状態は hidden。chat-rooms.js が available を取得できたら表示する
--}}
<section
    class="gh-chat-rooms gh-outer"
    data-chat-rooms
    data-community-api-domain="{{@custom.community_api_domain}}"
    data-community-web-domain="{{@custom.community_web_domain}}"
    hidden
>
    <div class="gh-chat-rooms-inner gh-inner">
        <div class="gh-chat-rooms-head">
            <h2 class="gh-chat-rooms-title">Community</h2>
            <a class="gh-chat-rooms-more" data-chat-rooms-more href="/rooms">もっとみる</a>
        </div>
        <div class="gh-chat-rooms-feed" data-chat-rooms-feed></div>
    </div>
</section>
<style>
    .gh-chat-rooms {
        margin-top: 48px;
    }
    .gh-chat-rooms-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .gh-chat-rooms-title {
        margin: 0;
        font-size: 2.4rem;
    }
    .gh-chat-rooms-more {
        white-space: nowrap;
        text-decoration: none;
        color: inherit;
    }
    .gh-chat-rooms-feed {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
    @media (min-width: 768px) {
        .gh-chat-rooms-feed {
            grid-template-columns: repeat(6, 1fr);
        }
    }
    .gh-chat-room-card {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
    }
    .gh-chat-room-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        background-color: rgba(0, 0, 0, 0.08);
    }
    .gh-chat-room-icon--placeholder {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        background-color: rgba(0, 0, 0, 0.35);
    }
    .gh-chat-room-name {
        margin: 8px 0 0;
        font-size: 14px;
        font-weight: 600;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
