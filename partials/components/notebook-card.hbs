<a class="voyage-notebook-card" href="{{url}}">
    <span class="voyage-notebook-card-meta">
        <time class="voyage-date" datetime="{{date format="YYYY-MM-DD"}}">date {{date format="YYYY.MM.DD"}}</time>
        {{> "components/new-badge" variant="blue"}}
    </span>
    <h3 class="voyage-notebook-card-title">{{title}}</h3>
    <img class="voyage-notebook-card-chevron" src="{{asset "images/voyage_chevron_card.svg"}}" alt="" width="7" height="10">
</a>
