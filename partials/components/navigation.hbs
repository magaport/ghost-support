<header class="voyage-header">
    <a class="voyage-header-logo" href="{{@site.url}}">
        {{!-- ヒーローの白抜きロゴは Publication logo から引くので、ヘッダーの色付きロゴは差し替え先が無く同梱する --}}
        <img src="{{asset "images/voyage_logo_header.svg"}}" alt="{{@site.title}}" width="81" height="49">
    </a>

    <button class="voyage-burger" type="button" aria-label="メニューを開く" aria-controls="voyage-menu" aria-expanded="false" data-menu-open>
        <img src="{{asset "images/voyage_menu.svg"}}" alt="" width="43" height="31">
    </button>
</header>

{{!-- お知らせバーのスクリプトはこの id の要素があればそこに描く。無ければ body の先頭に足すので、ヘッダーの上に出てしまう --}}
<div id="announcement-bar-root"></div>

{{!-- メニューを開いたときのデザインは未着手なので仮。
      raiden の Popover API は top layer に出るため、メニューを開いたまま Portal のダイアログを前に出せない。
      z-index が効く通常の固定配置にし、開閉と Esc は assets/js/menu.js で持つ --}}
<nav id="voyage-menu" class="voyage-menu" aria-label="メニュー" hidden>
    <div class="voyage-header voyage-menu-header">
        <a class="voyage-header-logo" href="{{@site.url}}">
            <img src="{{asset "images/voyage_logo_header.svg"}}" alt="{{@site.title}}" width="81" height="49">
        </a>
        <button class="voyage-burger voyage-menu-close" type="button" aria-label="メニューを閉じる" data-menu-close>
            <span class="voyage-menu-close-icon" aria-hidden="true"></span>
            <span class="voyage-burger-label">CLOSE</span>
        </button>
    </div>

    <div class="voyage-menu-body">
        <div class="voyage-menu-primary">
            {{navigation}}
        </div>

        {{#if @site.members_enabled}}
            <div class="voyage-menu-member">
                {{#if @member}}
                    <a class="voyage-button is-sub" href="#/portal/account" data-portal="account">マイページ</a>
                {{else}}
                    <a class="voyage-button is-primary" href="#/portal/signup" data-portal="signup">新規入会はこちら</a>
                    <a class="voyage-text-link" href="#/portal/signin" data-portal="signin">ログイン</a>
                {{/if}}
            </div>
        {{/if}}

        <div class="voyage-menu-secondary">
            {{navigation type="secondary"}}
        </div>
    </div>
</nav>
