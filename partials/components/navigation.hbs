<header class="raiden-header">
    <a class="raiden-header-logo" href="{{@site.url}}">
        <img src="{{asset "images/raiden_logo_header.png"}}" alt="{{@site.title}}" width="104" height="40">
    </a>

    <div class="raiden-header-actions">
        {{#if @site.members_enabled}}
            {{#unless @member}}
                <a class="raiden-header-login" href="#/portal/signin" data-portal="signin">LOG IN</a>
            {{else}}
                <a class="raiden-header-login" href="#/portal/account" data-portal="account">ACCOUNT</a>
            {{/unless}}
        {{/if}}

        <button class="raiden-burger" type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="raiden-menu">
            <span class="raiden-burger-line"></span>
            <span class="raiden-burger-line"></span>
            <span class="raiden-burger-line"></span>
        </button>
    </div>
</header>

{{!-- お知らせバーのスクリプトはこの id の要素があればそこに描く。無ければ body の先頭に足すので、ヘッダーの上に出てしまう --}}
<div id="announcement-bar-root"></div>

<nav id="raiden-menu" class="raiden-menu" aria-hidden="true">
    <button class="raiden-menu-close" type="button" aria-label="メニューを閉じる">&times;</button>
    {{navigation}}
</nav>

