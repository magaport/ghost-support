{{#if @site.members_enabled}}
    {{#unless @member}}
        {{!-- compact=true で見出しを省きボタンだけの帯にする（About 用） --}}
        <section class="raiden-cta{{#if compact}} is-compact{{/if}}">
            {{#unless compact}}
                <h2 class="raiden-cta-title">この先は会員限定</h2>
            {{/unless}}
            <a class="raiden-cta-button" href="#/portal/signup" data-portal="signup">
                入会する
                <svg class="raiden-cta-bolt" viewBox="0 0 9 21" aria-hidden="true"><path d="M6 0 0 12h4l-2 9 7-13H5l3-8z"/></svg>
            </a>
        </section>
    {{/unless}}
{{/if}}
