{{!-- EC 初期化: サーバーサイドでしか取得できない値を渡して JS に委譲する --}}
{{!-- URL 設定は assets/js/ec-config.js（.gitignore 対象）で環境ごとに管理。
      ロジック本体は assets/js/ec-init.js を参照（built/source.js に concat 済み）。 --}}
<script src="{{asset "js/ec-config.js"}}"></script>
<script>
  initEC({
    isGhostMember: {{#if @member}}true{{else}}false{{/if}},
    memberUuid: '{{@member.uuid}}',
    servicePath: '{{@custom.fms_service_path}}',
    apiKey: '{{@custom.fms_api_key}}'
  });
</script>

{{!-- カートモーダル（トリガーボタンはナビゲーション側に配置） --}}
<fms-cart hide-button="true" continue-shopping-url="/product/list/"></fms-cart>