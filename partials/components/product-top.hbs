{{!--
    トップページの商品一覧(Goods Store)。
    home.hbs から {{> "components/product-top"}} で呼び出すことを想定。
    <product-list> は mp-fms-cart が提供するカスタム要素(ec-init が初期化)。
--}}
{{#if @custom.fms_api_key}}
<section class="gh-product-top gh-outer">
    <div class="gh-product-top-inner gh-inner">
        <div class="gh-product-top-head">
            <h2 class="gh-product-top-title">Goods Store</h2>
            <a class="gh-product-top-more" href="/product/list/">もっとみる</a>
        </div>
        <div class="gh-product-top-feed">
            <product-list href-tpl="/product/detail/?id={id}" limit="3" cart-url="/shopping-cart/" checkout-url="/checkout/"></product-list>
        </div>
    </div>
</section>

<style>
    .gh-product-top {
        margin-top: 48px;
    }

    .gh-product-top-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .gh-product-top-title {
        margin: 0;
        font-size: 2.4rem;
    }

    .gh-product-top-more {
        white-space: nowrap;
        text-decoration: none;
        color: inherit;
    }

    .gh-product-top-feed .product-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 12px;
    }

    .gh-product-top-feed .product-grid::-webkit-scrollbar {
        display: none;
    }

    .gh-product-top-feed .product-card {
        flex: 0 0 140px;
        scroll-snap-align: start;
    }

    /* マウスにはスワイプがなく、ホイールも縦方向しか出さないため、
       スクロールバーを操作手段として残す */
    @media (hover: hover) and (pointer: fine) {
        /* 高さを明示すると常時表示・4px固定になる。display の復活だけだと
           OS既定のバー（15px・配色変更不可）に戻り、macOSの設定次第では非表示になる。
           scrollbar-width を併記するとChromeがこの指定を無視するため書かない */
        .gh-product-top-feed .product-grid::-webkit-scrollbar {
            display: block;
            height: 4px;
        }

        /* スクロールコンテナの padding はスクロールバーより内側に入るため、
           カードとバーの間の余白になる */
        .gh-product-top-feed .product-grid {
            padding-bottom: 8px;
        }

        .gh-product-top-feed .product-grid::-webkit-scrollbar-track {
            background: transparent;
        }

        .gh-product-top-feed .product-grid::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.25);
            border-radius: 2px;
        }
    }
</style>
{{/if}}
