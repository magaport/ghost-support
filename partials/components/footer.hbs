<footer class="raiden-footer">
    <ul class="raiden-footer-menu">
        <li><a href="{{@site.url}}/terms-of-service/">利用規約</a></li>
        <li><a href="{{@site.url}}/privacy-consent/">プライバシーポリシー</a></li>
        <li><a href="{{@site.url}}/tokushoho/">特商法に基づく表示</a></li>
    </ul>

    <div class="raiden-footer-brand">
        <img class="raiden-footer-logo" src="{{asset "images/raiden_logo_footer.png"}}" alt="TEAM RAIDEN" width="178" height="61">

        {{!-- リンク先は Ghost 標準の Settings > Social accounts から引く。
              テーマ設定に持たせると既定値が空でアイコンが出ないため --}}
        <div class="raiden-footer-social">
            {{#if @site.youtube}}
                <a href="{{social_url type="youtube"}}" target="_blank" rel="noopener" aria-label="YouTube">
                    <img class="is-youtube" src="{{asset "images/youtube_logo.png"}}" alt="YouTube" width="54" height="38">
                </a>
            {{/if}}
            {{#if @site.instagram}}
                <a href="{{social_url type="instagram"}}" target="_blank" rel="noopener" aria-label="Instagram">
                    <img class="is-instagram" src="{{asset "images/instagram_logo.png"}}" alt="Instagram" width="48" height="48">
                </a>
            {{/if}}
            {{#if @site.twitter}}
                <a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">
                    <img class="is-x" src="{{asset "images/x_logo.png"}}" alt="X" width="43" height="44">
                </a>
            {{/if}}
        </div>
    </div>
</footer>

<div class="raiden-copyright">&copy;{{date format="YYYY"}} TEAM RAIDEN</div>
