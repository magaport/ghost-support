<footer class="voyage-footer">
    <img class="voyage-footer-boat" src="{{asset "images/voyage_line_boat.svg"}}" alt="" width="432" height="104">

    {{navigation type="secondary"}}

    {{!-- リンク先は Ghost 標準の Settings > Social accounts から引く。
          テーマ設定に持たせると既定値が空でアイコンが出ないため --}}
    <div class="voyage-footer-social">
        {{#if @site.twitter}}
            <a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="X">
                <img src="{{asset "images/voyage_x.svg"}}" alt="" width="42" height="43">
            </a>
        {{/if}}
        {{#if @site.instagram}}
            <a href="{{social_url type="instagram"}}" target="_blank" rel="noopener" aria-label="Instagram">
                <img src="{{asset "images/voyage_instagram.svg"}}" alt="" width="53" height="53">
            </a>
        {{/if}}
    </div>

    {{!-- Figma に無く、文言は先方に確認中。raiden と同じく Site title で仮置きする --}}
    <p class="voyage-copyright">&copy;{{date format="YYYY"}} {{@site.title}}</p>
</footer>
