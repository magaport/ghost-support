<header class="community-header">
    <div class="community-header-wrapper">
        <a class="community-logo-wrapper" href="{{@site.url}}">
            <img class="community-logo" src="{{asset "images/community-logo.svg"}}" alt="LOGO" />
        </a>
        {{#if @member}}
            <div class="community-nav-user">
                {{#if @member.paid}}
                    <a class="community-nav-user-avatar-placeholder" href="#/portal/account" data-portal="subscribe">
                        <img src="{{@member.avatar_image}}" alt="{{@member.name}}" class="community-nav-user-avatar">
                    </a>
                {{else}}
                    <a class="community-nav-user-avatar-placeholder" href="#/portal/account" data-portal="subscribe" data-member-name="{{@member.name}}">
                        <span class="community-nav-user-initial"></span>
                    </a>
                {{/if}}
                {{> "search-toggle"}}
            </div>
        {{else}}
            <div class="community-nav">
                <a class="community-login" href="#/portal/signin" data-portal="signin">ログイン</a>
                <a class="community-signup" href="#/portal/signup" data-portal="signup">新規登録</a>
            </div>
        {{/if}}
        <button class="community-menu-button" aria-label="メニュー">
            <div class="community-hamburger">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </div>
        </button>
    </div>
</header>
<div class="community-nav-overlay"></div>
<nav class="community-nav-menu">
    <div class="community-nav-menu-primary">
        {{navigation}}
        <a class="community-nav-menu-external-link" href="" target="_blank" rel="noopener">
            <span>SNS</span>{{> "icons/box-arrow"}}
        </a>
        {{#if @member}}
            <a class="community-nav-menu-signout" href="javascript:" data-members-signout>ログアウト</a>
        {{/if}}
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize user avatar placeholders with first letter
        const avatarPlaceholders = document.querySelectorAll('.community-nav-user-avatar-placeholder');

        avatarPlaceholders.forEach(function(placeholder) {
            // Get the data-member-name attribute or fallback to text content
            const memberName = placeholder.getAttribute('data-member-name') || placeholder.textContent.trim();
            if (memberName) {
                // Get first letter and create or update the span
                const firstLetter = memberName.charAt(0).toUpperCase();
                let initialSpan = placeholder.querySelector('.community-nav-user-initial');
                if (!initialSpan) {
                    initialSpan = document.createElement('span');
                    initialSpan.className = 'community-nav-user-initial';
                    placeholder.appendChild(initialSpan);
                }

                initialSpan.textContent = firstLetter;
            }
        });

        // Toggle mobile menu
        const header = document.querySelector('.community-header');
        const menuButton = header?.querySelector('.community-menu-button');
        const navMenu = document.querySelector('.community-nav-menu');
        const navOverlay = document.querySelector('.community-nav-overlay');

        if (menuButton) {
            menuButton.addEventListener('click', function() {
                header.classList.toggle('is-open');
                navMenu.classList.toggle('is-open');
                navOverlay.classList.toggle('is-open');
                if (header.classList.contains('is-open')) {
                    document.documentElement.style.overflowY = 'hidden';
                } else {
                    document.documentElement.style.overflowY = null;
                }
            });
        }

        // Check membership status using {{@member}}
        const isLoggedIn = {{#if @member}}true{{else}}false{{/if}};

        // If not logged in, hide the .nav-contact link
        // (assuming there is a <li class="nav-contact"> inside <ul class="nav">)
        const navContact = document.querySelector('.community-nav-menu-primary ul.nav li.nav-contact');
        if (navContact && !isLoggedIn) {
            navContact.style.display = 'none';
        }
    });
</script>
