{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- 公開済みの記事が無いタグは Ghost が 404 にするので、/tag/staff/ は routes.yaml の channel で開く。
      channel には tag のデータが無く、data: tag.staff で渡すと同じ理由で 404 になるので、見出しは固定で書く --}}
<main class="voyage-list">
    <section class="voyage-section">
        {{> "components/section-heading" label="スタッフ通信"}}
        {{!-- 非会員には一覧を見せず、見出しの下に入会の案内を出す --}}
        {{#if @member}}
            {{> "components/card-grid"}}
            {{pagination}}
        {{else}}
            {{> "components/paid-only"}}
        {{/if}}
    </section>
</main>
