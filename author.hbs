{{!< default}}
<main class="community-author-main">
    {{#author}}
        <section class="community-author-profile">
            {{#if cover_image}}
                <img
                    class="community-author-cover"
                    src="{{img_url cover_image size="l"}}"
                    alt="{{name}}"
                >
            {{else}}
                <img class="community-author-cover" src="{{asset "images/default_author_feature.png"}}" alt="{{name}}">
            {{/if}}
            {{#if profile_image}}
                <img class="community-author-profile-image" src="{{img_url profile_image size="s"}}" alt="{{name}}">
            {{else}}
                <div class="community-author-profile-image">
                    {{> "icons/avatar"}}
                </div>

            {{/if}}
            <div class="community-author-details">
                <h1 class="community-author-name">
                    {{name}}
                </h1>
                {{#if location}}
                    <p class="community-author-location">{{location}}</p>
                {{/if}}
            </div>
        </section>
        <h2 class="community-post-list-title">
            {{> "icons/cat-footprint"}}
            <ul class="community-post-list-tabs">
                <li class="community-tab active" data-tab="all">All</li>
                <li class="community-tab" data-tab="free">Free</li>
                <li class="community-tab" data-tab="vip">VIP</li>
            </ul>
        </h2>
        {{!-- All posts --}}
        {{#get "posts" include="authors" filter="authors:{{slug}}"  order="published_at desc" as |postsAll|}}
            {{#if postsAll}}
                <section id="posts-all" class="community-post-list-section">
                    <h3 class="community-post-list-subtitle-no-more">
                        最新記事
                    </h3>
                    <div class="community-post-list">
                        {{#foreach postsAll}}
                            <article class="community-post-item">
                                <a href="{{url}}">
                                    {{#if feature_image}}
                                        <img class="community-post-item-image" src="{{feature_image}}" alt="{{title}}">
                                    {{else}}
                                        <img class="community-post-item-image" src="{{asset "images/default_post_feature.png"}}" alt="{{title}}">
                                    {{/if}}
                                    <div class="community-post-title">
                                        <h4>{{title}}</h4>
                                        <div class="community-post-meta">
                                            <time datetime="{{date format="YYYY-MM-DD"}}">
                                                {{date format="YYYY/MM/DD"}}
                                            </time>
                                            {{#if authors.[0]}}
                                                <span> {{authors.[0].name}}</span>
                                            {{/if}}
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {{/foreach}}
                    </div>
                </section>
            {{/if}}
        {{/get}}

        {{!-- Free posts --}}
        {{#get "posts" include="authors" filter="authors:{{slug}}" order="published_at desc" as |postsFree|}}
            {{#if postsFree}}
                <section id="posts-free" class="community-post-list-section" style="display: none;">
                    <h3 class="community-post-list-subtitle-no-more">
                        最新記事
                    </h3>
                    <div class="community-post-list">
                        {{#foreach postsFree visibility='all'}}
                            {{#has visibility="public"}}
                                <article class="community-post-item">
                                    <a href="{{url}}">
                                        {{#if feature_image}}
                                            <img class="community-post-item-image" src="{{feature_image}}" alt="{{title}}">
                                        {{else}}
                                            <img class="community-post-item-image" src="{{asset "images/default_post_feature.png"}}" alt="{{title}}">
                                        {{/if}}
                                        <div class="community-post-title">
                                            <h4>{{title}}</h4>
                                            <div class="community-post-meta">
                                                <time datetime="{{date format="YYYY-MM-DD"}}">
                                                    {{date format="YYYY/MM/DD"}}
                                                </time>
                                                {{#if authors.[0]}}
                                                    <span> {{authors.[0].name}}</span>
                                                {{/if}}
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            {{/has}}
                        {{/foreach}}
                    </div>
                </section>
            {{/if}}
        {{/get}}

        {{!-- VIP posts --}}
        {{#get "posts" include="authors" filter="authors:{{slug}}" order="published_at desc" as |postsVIP|}}
            {{#if postsVIP}}
                <section id="posts-vip" class="community-post-list-section" style="display: none;">
                    <h3 class="community-post-list-subtitle-no-more">
                        最新記事
                    </h3>
                    <div class="community-post-list">
                        {{#foreach postsVIP visibility='all'}}
                            {{#has visibility="paid"}}
                                <article class="community-post-item">
                                    <a href="{{url}}">
                                        {{#if feature_image}}
                                            <img class="community-post-item-image" src="{{feature_image}}" alt="{{title}}">
                                        {{else}}
                                            <img class="community-post-item-image" src="{{asset "images/default_post_feature.png"}}" alt="{{title}}">
                                        {{/if}}
                                        <div class="community-post-title">
                                            <h4>{{title}}</h4>
                                            <div class="community-post-meta">
                                                <time datetime="{{date format="YYYY-MM-DD"}}">
                                                    {{date format="YYYY/MM/DD"}}
                                                </time>
                                                {{#if authors.[0]}}
                                                    <span> {{authors.[0].name}}</span>
                                                {{/if}}
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            {{/has}}
                        {{/foreach}}
                    </div>
                </section>
            {{/if}}
        {{/get}}
    {{/author}}
</main>


<script>
    document.addEventListener('DOMContentLoaded', function(){
        const tabs = document.querySelectorAll('.community-tab');
        const sections = {
            all: document.getElementById('posts-all'),
            free: document.getElementById('posts-free'),
            vip: document.getElementById('posts-vip')
        };

        tabs.forEach(tab => {
            tab.addEventListener('click', function(){
                // Remove active class from all tabs
                tabs.forEach(t => t.classList.remove('active'));
                // Hide all sections
                Object.values(sections).forEach(section => section.style.display = 'none');
                // Activate the clicked tab and show corresponding section
                this.classList.add('active');
                const tabName = this.getAttribute('data-tab');
                if (sections[tabName]) {
                    sections[tabName].style.display = 'block';
                }
            });
        });
    });
</script>