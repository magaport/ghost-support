{{!< default }}

<main class="gh-main gh-main-ec">
  <fms-cart inline="true" hide-button="true" start-view="checkout" cart-url="/shopping-cart/" complete-url="/order-complete/" continue-shopping-url="/product/list/"></fms-cart>
  <script>
    document.addEventListener("fms:event", function(e) {
      var type = e.detail && e.detail.eventType;
      if (type === "modal_close") history.back();
    });
  </script>
</main>
